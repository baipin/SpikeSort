# CPU frequency
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ESP32-S3-PICO-1: 8MB flash + 8MB Octal PSRAM.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# FreeRTOS 1 ms tick
CONFIG_FREERTOS_HZ=1000

# WiFi/lwIP buffer tuning for UDP TX throughput diagnostics.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y
# CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER is not set
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=64
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_TX_BA_WIN=12
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_RX_BA_WIN=16
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64

# UDP maximum-throughput sender connection settings.
CONFIG_BANDWIDTH_WIFI_SSID="Dennis"
CONFIG_BANDWIDTH_WIFI_PASSWORD="60763312"
CONFIG_BANDWIDTH_TRANSPORT_UDP=y
# CONFIG_BANDWIDTH_TRANSPORT_TCP is not set
CONFIG_BANDWIDTH_SERVER_IP="192.168.137.1"
CONFIG_BANDWIDTH_SERVER_PORT=5001
CONFIG_BANDWIDTH_PAYLOAD_BYTES=1024
CONFIG_BANDWIDTH_FPS=1000
CONFIG_BANDWIDTH_UNLIMITED_SEND=y
CONFIG_BANDWIDTH_SEND_TIMEOUT_MS=10
CONFIG_BANDWIDTH_SOCKET_SNDBUF=0
CONFIG_BANDWIDTH_WIFI_PS_NONE=y
# CONFIG_BANDWIDTH_WIFI_11N_ONLY is not set
CONFIG_BANDWIDTH_WIFI_11GN_ONLY=y
CONFIG_BANDWIDTH_WIFI_HT40=y
# CONFIG_BANDWIDTH_LOG_DROPPED_FRAMES is not set
CONFIG_BANDWIDTH_SNTP_ENABLE=y
CONFIG_BANDWIDTH_SNTP_SERVER="pool.ntp.org"
CONFIG_BANDWIDTH_SNTP_SYNC_TIMEOUT_MS=5000
# CONFIG_BANDWIDTH_REQUIRE_SNTP is not set

# USB Serial/JTAG log console
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Project partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
